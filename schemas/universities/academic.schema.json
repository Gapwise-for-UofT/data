    "terms":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","nativeName","startDate","endDate","sourceId"],"properties":{"id":{"type":"string","minLength":1},"nativeName":{"type":"string","minLength":1},"startDate":{"type":"string","format":"date"},"endDate":{"type":"string","format":"date"},"sourceId":{"type":"string","minLength":1}}}},
    "courses":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["code","title","termId","sections","sourceId"],"properties":{"code":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"termId":{"type":"string","minLength":1},"sourceId":{"type":"string","minLength":1},"sections":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["nativeSection","nativeComponentType","crn","linkedSectionIds","meetings","sourceId"],"properties":{"nativeSection":{"type":"string","minLength":1},"nativeComponentType":{"type":"string","minLength":1},"crn":{"type":["string","null"]},"linkedSectionIds":{"type":"array","items":{"type":"string"}},"sourceId":{"type":"string","minLength":1},"meetings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["days","startTime","endTime","startDate","endDate","nativeLocation"],"properties":{"days":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["MO","TU","WE","TH","FR","SA","SU"]}},"startTime":{"type":"string","pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$"},"endTime":{"type":"string","pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$"},"startDate":{"type":"string","format":"date"},"endDate":{"type":"string","format":"date"},"nativeLocation":{"type":["string","null"]}}}}}}}}}}
